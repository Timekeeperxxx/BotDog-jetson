# BotDog 后端配置模板
# 复制此文件为 .env 并根据实际情况修改：
#   cp backend/.env.example backend/.env

# ==================== 基础网络 ====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==================== 数据库 & MAVLink ====================
DATABASE_URL=sqlite+aiosqlite:///./data/botdog.db
# 真实硬件示例：serial:/dev/ttyUSB0:57600
MAVLINK_ENDPOINT=udp:127.0.0.1:14550
# mavlink=真实硬件 | simulation=纯模拟
MAVLINK_SOURCE=simulation
# MAVLINK_SOURCE=simulation 时设为 true 以生成随机遥测数据
SIMULATION_WORKER_ENABLED=true

# ==================== 安全 ====================
# 生产环境请务必修改为随机字符串
JWT_SECRET=please_change_me_to_a_random_string
# 生产环境必须修改 AUTH_ADMIN_PASSWORD 和 JWT_SECRET
# AUTH_ENABLED=false 仅限本地开发调试
AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123
JWT_EXPIRE_MINUTES=720

# ==================== CORS ====================
# 生产环境改为前端实际 IP，如 ["http://192.168.110.247:5173"]
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ==================== 遥测 ====================
HEARTBEAT_TIMEOUT=3.0
TELEMETRY_SAMPLING_HZ=2.0
TELEMETRY_BROADCAST_HZ=15.0

# ==================== 告警 ====================
THERMAL_THRESHOLD=80.0

# ==================== 黄色区域识别 ====================
# HSV 色调范围（OpenCV H: 0-180，纯黄约 25-35）
# 检测不到 → 降低 H_LOW 或 S_LOW；误检橙/白色 → 提高 H_LOW 或 S_LOW
ZONE_YELLOW_H_LOW=14
ZONE_YELLOW_H_HIGH=42
ZONE_YELLOW_S_LOW=25
ZONE_YELLOW_S_HIGH=220
ZONE_YELLOW_V_LOW=95
ZONE_YELLOW_V_HIGH=255

# 黑边验证：环形区域 V 通道 10th percentile 低于此值才算有黑边
# 现在用低百分位数而非均值，只需环内有少数黑色橡胶像素即可通过
# 黑色橡胶 V ≈ 5-30；无黑边的地毯/浅色+地面全部像素 V > 50
# 建议范围 30~50；检不到时调高，误报时调低
ZONE_BORDER_V_THRESHOLD=70
# 向外扩多少像素采样黑边
ZONE_BORDER_EXPAND_PX=1

# 面积约束（过小/过大的区域直接过滤）
ZONE_MIN_AREA_PX=600
ZONE_MAX_AREA_RATIO=0.25

# 形状约束
ZONE_MIN_ASPECT=1.5
ZONE_MAX_ASPECT=30.0
ZONE_MIN_SOLIDITY=0.45

# ROI：跳过画面顶部此比例，只处理含地面的下部（加速约 35%）
ZONE_ROI_TOP_RATIO=0.55

# 形态学核大小（越大填孔越强，也越慢；建议 5~11）
ZONE_MORPH_KERNEL_SIZE=32

# quality 综合评分权重（三项之和建议为 1.0）
ZONE_W_AREA=0.25
ZONE_W_SOLID=0.2
ZONE_W_BORDER=0.55
# 中心黑色汉字检测：中心区裁剪比例（0.5 = 取四边形内接矩形的中心 50% 面积）
ZONE_CENTER_CROP_RATIO=0.55
# 汉字像素暗度阈值：V 通道低于此值才算黑色像素
ZONE_CENTER_BLACK_V_THRESHOLD=85
# 中心区内暗像素占比下限，超过此比例认为有汉字
ZONE_CENTER_BLACK_MIN_RATIO=0.08
# 检测到汉字时的 quality 奖励分（叠加在 0-1 质量分之上）
ZONE_CENTER_TEXT_BONUS=0.20

# ==================== 驱离任务 ====================
# 驱离任务总开关
GUARD_MISSION_ENABLED=false

# ---- 状态机时序 ----
# 入侵确认时间（秒）：脚点持续在区域内多久才触发出动
GUARD_CONFIRM_TIME_S=1.5
# 清空确认时间（秒）：人离开区域后持续多久才触发返航
GUARD_CLEAR_TIME_S=3.0
# 最短驱离持续时间（秒）：出动后至少运行多久才开始检查人有没有离开
GUARD_MIN_DURATION_S=3.0
# 单次驱离最大持续时间（秒）：超过此时间强制返航
GUARD_MAX_DURATION_S=120.0
# 两次出动之间的冷却时间（秒）
GUARD_COOLDOWN_S=5.0

# ---- 出动 / 返回动作时长 ----
# 前往驱离点的前进时间（秒）
GUARD_DEPLOY_DURATION_S=10.0
# 返回起点的后退时间（秒）
GUARD_RETURN_DURATION_S=10.0
# 起立后稳定等待时间（秒）
GUARD_DEPLOY_SETTLE_S=2.0
# 蹲坐后稳定等待时间（秒）
GUARD_RETURN_SETTLE_S=2.0

# ---- 视觉伺服 / 前进保护 ----
# 前进停止阈值：区域宽或高占画面此比例时停止前进（防止贴脸）
GUARD_MAX_VIEW_RATIO=0.90
# 区域边缘裕量：bbox 任意边距屏幕边缘小于此比例时禁止前进，只允许转向（防丢区域）
# 0.08 = 左/右/下边缘各留出 8% 的安全距离
GUARD_ZONE_EDGE_MARGIN_RATIO=0.08
# 最大推进保护时间（秒）：超时强制停止，防撞墙
GUARD_MAX_ADVANCE_TIME_S=15.0
# 视觉链路健康超时（秒）：超时则降级处理
GUARD_VISUAL_TIMEOUT_S=5.0
GUARD_ZONE_MEMORY_FRAMES=20
GUARD_ZONE_LOST_RETURN_S=3.0

# ---- 锚点跟踪 ----
# 锚点跟踪最小稳定质量（0~1）
GUARD_ANCHOR_MIN_QUALITY=0.6
# 连续跟丢多少秒认为完全丢失
GUARD_ANCHOR_LOST_TIMEOUT_S=2.0

# ---- 清空判定 ----
# 清空判定最小有效置信度
GUARD_CLEAR_MIN_CONF=0.4
# 清空判定最小有效目标面积（px）
GUARD_CLEAR_MIN_AREA=2000
# 人框在锚点框内的重叠比例上限（超过此值不算离开）
GUARD_OVERLAP_CLEAR_RATIO=0.10

# ---- 返航精度 ----
# 返航时允许的 X 中心误差（像素）
GUARD_RETURN_POS_TOLERANCE_PX=60
# 返航时允许的面积误差（0.15 = 回到起始大小的 ±15% 内即认为到位）
GUARD_RETURN_AREA_TOLERANCE_RATIO=0.5
# 返航完成需连续满足条件的帧数（防单帧误判）
GUARD_RETURN_STABLE_FRAMES=15
# 面积占屏幕比例低于此值触发停止判定（0.10 = 10%）
GUARD_RETURN_AREA_STOP_RATIO=0.02
# 面积 < 阈值需连续满足的帧数才判定到位（建议 5~20）
GUARD_RETURN_AREA_STABLE_FRAMES=10

# ---- 视觉伺服命令控制 ----
# 驱离视觉伺服偏航死区（像素）：区域中心偏离画面中心超过此值才转向
GUARD_YAW_DEADBAND_PX=120
# 驱离命令发送最小间隔（ms）：防止命令过密
GUARD_COMMAND_RATE_LIMIT_MS=100

# ---- 音频 ----
# 警告音频文件路径（相对于项目根）
GUARD_ALERT_AUDIO_PATH=assets/13282.wav


# ==================== 导航巡逻 / PCD 点云地图 Demo ====================
# PCD 点云地图所在目录。后端直接扫描该目录。
PCD_MAP_ROOT=/home/jetson/superlio/Super-LIO/src/super_lio/map

# 场景地图根目录（存放各场景的底图图片、语义标注等）
SCENE_MAP_ROOT=/home/jetson/Project/BOTDOG/MAPS

# 当前点云和导航点默认使用的坐标系
PCD_FRAME_ID=map

# 点云预览默认返回点数
PCD_PREVIEW_DEFAULT_POINTS=100000

# 点云预览最大允许返回点数，防止浏览器卡死
PCD_PREVIEW_MAX_POINTS=200000

# 导航点 JSON 存储目录
NAV_WAYPOINT_STORE_DIR=./data/nav_waypoints

# 定位初始化数据存储目录（initialpose 记录等）
NAV_LOCALIZATION_STORE_DIR=./data/nav_localization

# 导航任务存储目录（任务序列、执行记录等）
NAV_TASK_STORE_DIR=./data/nav_tasks

# 当前运行时任务目录
NAV_RUNTIME_DIR=./data/nav_runtime

# ==================== ROS2 导航状态订阅转发 ====================
# 是否启用后端 ROS2 导航位姿转发；没有 ROS2/rclpy/tf2_ros 环境时可改为 false。
ROS_NAV_ENABLED=true
ROS_NAV_MAPPING_CLOUD_FORWARD_ENABLED=true

# 位姿 topic 模式使用的 ROS2 topic；ROS_NAV_POSE_TYPE=TF 时不使用。
ROS_NAV_POSE_TOPIC=/amcl_pose

# 位姿来源类型。推荐 TF：后端查询 ROS_NAV_FRAME_ID -> ROS_NAV_BASE_FRAME_ID 的坐标变换。
# 也支持 PoseWithCovarianceStamped / PoseStamped / Odometry。
ROS_NAV_POSE_TYPE=TF

# TF 查询目标坐标系，也是前端点云 Demo 使用的地图坐标系。
ROS_NAV_FRAME_ID=map

# TF 查询源坐标系，通常是机器人本体坐标系 base_link。
ROS_NAV_BASE_FRAME_ID=base_footprint

# WebSocket 推送 nav.robot_pose 的最大频率，单位 Hz，避免 ROS2 高频话题直接压到前端。
ROS_NAV_BROADCAST_HZ=10

# 打开导航页或刷新页面时发布 Bool(true)，通知雷达侧开始工作。
ROS_NAV_PAGE_OPEN_TOPIC=/lidar_start

# 点击“导航”时先发布一个 Bool(true) 的开始信号，供底盘/导航节点接收。
ROS_NAV_START_TOPIC=/nav_start

# 历史兼容：旧的 PoseStamped 导航目标 topic。当前单点 go-to 主路径是 clicked_point + goal_yaw。
ROS_NAV_GOAL_TOPIC=/goal_pose

# 单点导航目标位置（geometry_msgs/PointStamped），前端点击地图时发布。
ROS_NAV_GOAL_XYZ_TOPIC=/clicked_point

# 单点导航目标朝向（std_msgs/Float32，单位弧度），与 clicked_point 配合使用。
ROS_NAV_GOAL_YAW_TOPIC=goal_yaw

# 全局规划路径（nav_msgs/Path），导航节点规划完成后发布，前端用于路径可视化。
ROS_NAV_GLOBAL_PATH_TOPIC=/global_path

# AMCL 初始位姿（geometry_msgs/PoseWithCovarianceStamped），由前端拖拽定位点后发布。
ROS_NAV_INITIAL_POSE_TOPIC=/initialpose

# 建图实时点云（sensor_msgs/PointCloud2），用于前端实时展示建图进度。
ROS_NAV_MAPPING_CLOUD_TOPIC=/lio/cloud_world

# 建图开关信号（std_msgs/Bool），前端点击"开始/停止建图"时发布。
ROS_NAV_MAPPING_TOPIC=/mapping_start

# 导航状态反馈（std_msgs/String），导航节点发布当前执行状态（navigating/arrived/failed 等）。
ROS_NAV_STATUS_TOPIC=/nav_status

# 点云 Demo 底部急停按钮发布 Bool(true) 的 ROS2 topic。
ROS_NAV_STOP_TOPIC=/nav_stop

# 需要 yolov8n.pt 模型（~6MB），下载：
# https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov8n.pt
AI_ENABLED=true
# AI Worker 从 MediaMTX 拉取推理帧
AI_RTSP_URL=rtsp://127.0.0.1:8554/cam
AI_FRAME_WIDTH=640
AI_FRAME_HEIGHT=360

# 推理帧率：越高 ByteTrack 跨帧 IOU 越稳，但 CPU 占用也越高
AI_FPS=5
AI_INFERENCE_IMGSZ=640
AI_FFMPEG_RETRY_MIN_SECONDS=1.0
AI_FFMPEG_RETRY_MAX_SECONDS=3.0

# 巡逻跳帧：每隔多少帧推理一次（1=不跳帧，建议 1~3）
# 过大会导致摄像头抖动时相邻帧位移过大，ByteTrack 断轨丢目标
AI_PATROL_SKIP=2
AI_AUTO_TRACK_SKIP=1

# 发现疑似目标后切全速推理，保持 1 即可
AI_SUSPECT_SKIP=1

# 锁定目标需要连续命中几帧（值越小锁定越快，但误报也增加）
AI_STABLE_HITS=5

# 连续几帧未检测到才放弃目标（值越大对遮挡/抖动越宽容）
AI_RESET_MISSES=20

# 同一目标停止告警后，多少秒内不重复告警
AI_COOLDOWN_SECONDS=5.0

# 推理设备：auto 自动选 cuda/cpu | cpu | cuda
AI_DEVICE=auto
AI_MODEL_PATH=models/helmet.engine

# 置信度阈值：越低检出率越高但误报变多，运动模糊场景建议 0.3~0.4
AI_CONFIDENCE_THRESHOLD=0.4
AI_TARGET_CLASSES=["person","head","helmet"]
# false=YOLO predict + 后端 IOU 临时 track_id，帧率更高；
# true=YOLO ByteTrack，ID 更稳但 Jetson 上开销更大。
AI_USE_BYTETRACK=false

# 抓拍图片存储目录（相对于项目根）
SNAPSHOT_DIR=data/snapshots

# 调试用模拟检测，无需模型文件，正式部署必须关闭
AI_SIMULATE_DETECTION=false
AI_SIMULATE_PROB=0.02

# ==================== 控制服务 ====================
# simulation=仅打印日志 | unitree_b2=宇树 B2 真实硬件
CONTROL_ADAPTER_TYPE=unitree_b2

# 前端超过此时间未发命令，后端自动执行 stop（真实硬件 RPC 延迟大，建议 1500ms）
CONTROL_WATCHDOG_TIMEOUT_MS=1500

# 前端命令最小发送间隔（ms），stop 命令不受此限制
CONTROL_CMD_RATE_LIMIT_MS=50

# SafetySupervisor：底层链路断开时是否阻止运动命令。
# 开发调试可设为 false，真机部署建议保持 true。
SAFETY_BLOCK_MOTION_WHEN_DISCONNECTED=true

# ==================== 自动跟踪 ====================
AUTO_TRACK_ENABLED=false
AI_PASSIVE_SESSION_DETECTION_ENABLED=true

# ---- 导航任务跟踪联动 ----
# 是否允许“导航任务执行中”由陌生人检测触发自动跟踪。
# false=导航时只执行导航，不因画面中出现陌生人暂停任务；可在导航页面用“跟踪联动”按钮临时开启。
NAV_AUTO_TRACK_DURING_NAV_ENABLED=false
# 开始导航任务时是否自动启用自动跟踪服务。
# false=执行任务不会自动打开自动跟踪；需要联动时先在导航页面打开“跟踪联动”。
NAV_AUTO_TRACK_AUTO_ENABLE=false

# ---- 命令节流 ----
# 追踪服务向控制服务发命令的最小间隔（ms）
AUTO_TRACK_COMMAND_INTERVAL_MS=100

# ---- 目标保持 / 丢失 ----
# 目标最短保持时间（s）
AUTO_TRACK_TARGET_HOLD_SECONDS=3.0
# 目标连续出追踪区域几帧后停止（@15fps: 10帧≈0.7s）
AUTO_TRACK_OUT_OF_ZONE_FRAMES=10
# 目标丢失几帧后回到 DETECTING 重新扫描（@15fps: 30帧≈2s）
AUTO_TRACK_LOST_TIMEOUT_FRAMES=30

# ---- 前进区域判断 ----
# 目标 bbox 面积超过画面面积的此比例时停止前进（防贴脸）
AUTO_TRACK_FORWARD_AREA_RATIO=0.30
# 目标底部锚点超过画面高度此比例时禁止前进，防近距离前冲
AUTO_TRACK_ANCHOR_Y_STOP_RATIO=0.95

# ---- 偏航控制 ----
# 画面中心±N 像素内不发转向命令，防止频繁左右抖动
AUTO_TRACK_YAW_DEADBAND_PX=100
# 转向命令发出后延迟此时间自动发 stop，防止过冲（ms，0=禁用）
AUTO_TRACK_YAW_PULSE_MS=0

# ---- 自动跟踪速度 ----
# 自动跟踪前进/后退速度（m/s）
AUTO_TRACK_VX=0.4

# ---- 抓拍 ----
# 跟踪结束时是否抓拍证据图
AUTO_TRACK_STOP_SNAPSHOT_ENABLED=true

# ==================== 宇树 B2 硬件 ====================
# 仅当 CONTROL_ADAPTER_TYPE=unitree_b2 时生效
# 连接 B2 的有线网卡名（用 ip addr 确认，换机器狗可能需要修改）
UNITREE_NETWORK_IFACE=eno1

# 前进/后退速度（m/s），B2 支持 0~0.6
UNITREE_B2_VX=0.3

# 偏航转速（rad/s），B2 支持 0~0.8
UNITREE_B2_VYAW=0.5

# ---- 驱离模式专用速度（独立于手动遥控，降低以提高运行稳定性）----
# 驱离前进/后退速度（m/s），B2 支持 0~0.6，建议 0.10~0.20
GUARD_VX=0.30
# 驱离偏航转速（rad/s），B2 支持 0~0.8，建议 0.20~0.30
GUARD_VYAW=0.25

# ==================== Settings defaults copied from backend/config.py ====================
RECORDING_DIR=data/recordings
NAV_WAYPOINT_GROUND_SNAP_MAX_DISTANCE_M=1.0
NAV_WAYPOINT_GROUND_SNAP_NEIGHBORS=24
NAV_ORIGIN_WAYPOINT_Z=-0.83
NAV_ORIGIN_WAYPOINT_YAW=0.0
NAV_AUTO_TRACK_RESUME_TIMEOUT_S=3.0
NAV_AUTO_TRACK_REQUIRE_FRESH_TF=true
NAV_CONTROL_GATEWAY_ENABLED=true
ROS_NAV_GOAL_Z_SEARCH_OFFSET_M=0.0
ZONE_DRAW_SAVED_FILL_RGBA=rgba(220,40,40,0.18)
ZONE_DRAW_SAVED_STROKE_RGBA=rgba(255,60,60,0.75)
ZONE_DRAW_SAVED_LINE_WIDTH=1.5
ZONE_DRAW_ACTIVE_STROKE_RGBA=rgba(0,255,120,0.85)
ZONE_DRAW_ACTIVE_LINE_WIDTH=1.5
ZONE_DRAW_POINT_RADIUS=4
ZONE_DRAW_DASH_ON=5
ZONE_DRAW_DASH_OFF=4
ZONE_DRAW_TOOLBAR_BOTTOM_PX=140
ZONE_DRAW_CANVAS_Z_INDEX=5
ZONE_DRAW_TOOLBAR_Z_INDEX=50
AUTO_TRACK_VYAW=0.22
