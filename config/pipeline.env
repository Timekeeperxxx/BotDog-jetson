# BotDog 视频硬件配置
#
# Z2 Mini 云台相机直连 enP8p1s0：
#   camera 192.168.123.108（固件每次启动可能生成不同的本地 MAC，不依赖 MAC 绑定）
#   host   192.168.123.222/24
CAMERA_RTSP_URL=rtsp://192.168.123.108:554/
CAM1_INPUT_CODEC=h264
# 每次 Linux 冷启动只静默等待一次，避免相机编码器初始化期间被频繁拉流。
CAM1_STARTUP_GRACE=30
# 端口打开不等于视频就绪；用 ffprobe 验证视频轨，并按 5/10/20/30 秒退避。
CAM1_PROBE_TIMEOUT=8
CAM1_RETRY_INITIAL_DELAY=5
CAM1_RETRY_MAX_DELAY=30
# 连续 3 次没有视频轨时先重启原厂图像服务并验证视频；仍失败则重启整台相机。
# 每轮两级恢复之间至少间隔 5 分钟，避免硬件故障时形成重启风暴。
CAM1_RECOVERY_ENABLED=1
CAM1_RECOVERY_FAILURES=3
CAM1_RECOVERY_COOLDOWN=300
CAM1_RECOVERY_SETTLE_DELAY=15
CAM1_RECOVERY_REBOOT_ENABLED=1
CAM1_RECOVERY_REBOOT_SETTLE_DELAY=45
CAM1_RECOVERY_TELNET_PORT=23
CAM1_RECOVERY_TIMEOUT=20
# 先飞 Z2-Mini GCU TCP 控制；启动及相机重连时关闭固件内置 OSD。
CAM1_CONTROL_PORT=2332
CAM1_OSD=off

# 原始流为 H.264 2560x1440；主画面使用 Jetson 硬件转码为 1080p。
CAM1_ENCODER=gst-nvenc
CAM1_WIDTH=1920
CAM1_HEIGHT=1080
# 相机冷启动后标称 30 fps；过热保护时可能降到约 5 fps。
# 软件回退路径不强制输出帧率，因此降频时不会复制补帧。
CAM1_FPS=30
CAM1_GOP=15
CAM1_BITRATE=2500k
CAM1_GST_BITRATE=2500000
CAM1_GST_VBV_SIZE=300000
CAM1_MAXRATE=3000k
CAM1_BUFSIZE=400k

# 远程 480p 档位同样使用 Jetson 硬件转码，避免额外占用 CPU。
CAM_REMOTE_ENCODER=gst-nvenc
CAM_REMOTE_FPS=5
CAM_REMOTE_GOP=5
CAM_REMOTE_BITRATE=600k
CAM_REMOTE_GST_BITRATE=600000
CAM_REMOTE_GST_VBV_SIZE=100000
